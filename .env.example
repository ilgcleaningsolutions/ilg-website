# ─── Required ─────────────────────────────────────────────────────────
# Resend API key — powers the contact form. https://resend.com/api-keys
RESEND_API_KEY=

# ─── Optional ─────────────────────────────────────────────────────────
# Interlink CRM API base URL. The "Talk to an expert" funnel on product pages
# submits leads here server-side (src/app/api/crm-lead/route.ts) — never
# exposed to the browser, so no NEXT_PUBLIC_ prefix.
# Defaults to https://crm.ilgcleaningsolutions.com/api/v1 if unset.
INTERLINK_API_URL=